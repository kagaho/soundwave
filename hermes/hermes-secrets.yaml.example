# Template for hermes-secrets — copy to `hermes-secrets.yaml` and fill in.
# The real file is .gitignore'd; never commit it.
#
# Apply with:
#   kubectl -n ai apply -f hermes-secrets.yaml
#
apiVersion: v1
kind: Secret
metadata:
  name: hermes-secrets
  namespace: ai
type: Opaque
stringData:
  # Telegram bot for Hermes gateway. Get from @BotFather → /mybots → API Token.
  # If you ever leak this, revoke at @BotFather → API Token → Revoke current token.
  TELEGRAM_BOT_TOKEN: "REPLACE_ME"

  # Add other provider keys as needed:
  # OPENROUTER_API_KEY: "REPLACE_ME"
  # ANTHROPIC_API_KEY: "REPLACE_ME"
  # GITHUB_TOKEN: "REPLACE_ME"   # raises skills-hub rate limit from 60/hr to 5000/hr
